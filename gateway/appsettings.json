{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identidad": {
        "ClusterId": "identidad",
        "Match": { "Path": "/identidad/{**resto}" },
        "Transforms": [
          { "PathRemovePrefix": "/identidad" },
          { "RequestHeaderRemove": "Origin" }
        ]
      },
      "estructura": {
        "ClusterId": "estructura",
        "Match": { "Path": "/estructura/{**resto}" },
        "Transforms": [
          { "PathRemovePrefix": "/estructura" },
          { "RequestHeaderRemove": "Origin" }
        ]
      },
      "entrenamiento": {
        "ClusterId": "entrenamiento",
        "Match": { "Path": "/entrenamiento/{**resto}" },
        "Transforms": [
          { "PathRemovePrefix": "/entrenamiento" },
          { "RequestHeaderRemove": "Origin" }
        ]
      },
      "seguimiento": {
        "ClusterId": "seguimiento",
        "Match": { "Path": "/seguimiento/{**resto}" },
        "Transforms": [
          { "PathRemovePrefix": "/seguimiento" },
          { "RequestHeaderRemove": "Origin" }
        ]
      },
      "asistente": {
        "ClusterId": "asistente",
        "Match": { "Path": "/asistente/{**resto}" },
        "Transforms": [
          { "PathRemovePrefix": "/asistente" },
          { "RequestHeaderRemove": "Origin" }
        ]
      }
    },
    "Clusters": {
      "identidad": { "Destinations": { "servicio": { "Address": "http://identidad:8080/" } } },
      "estructura": { "Destinations": { "servicio": { "Address": "http://estructura:8080/" } } },
      "entrenamiento": { "Destinations": { "servicio": { "Address": "http://entrenamiento:8080/" } } },
      "seguimiento": { "Destinations": { "servicio": { "Address": "http://seguimiento:8080/" } } },
      "asistente": { "Destinations": { "servicio": { "Address": "http://asistente:8080/" } } }
    }
  }
}
