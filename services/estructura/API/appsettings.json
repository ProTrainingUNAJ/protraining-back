{
    "Service": "Estructura",
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore": "Fatal"
            }
        }
    },
    "Cors": {
        "AllowedOrigins": [
            "http://localhost:5173"
        ]
    },
    "Reminders": {
        "WindowStart": 16,
        "WindowEnd": 20
    },
    "AllowedHosts": "*"
}
