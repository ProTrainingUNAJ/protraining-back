{
  "Service": "Asistente",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Fatal"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.2:1b",
    "TimeoutSeconds": 15
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-flash-lite-latest",
    "TimeoutSeconds": 10
  },
  "Services": {
    "Entrenamiento": {
      "BaseUrl": "http://localhost:8083"
    }
  },
  "AllowedHosts": "*"
}
