{
  "Service": "Asistente",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Fatal"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Ai": {
    "Agent": {
      "MaxToolCalls": 6,
      "TimeoutSeconds": 40,
      "Providers": [
        {
          "Name": "OpenAI",
          "BaseUrl": "https://rs-ai-gateway-unaj.azure-api.net/unaj-llm/openai/deployments/gpt-4.1-mini/?api-version=2025-03-01-preview",
          "Model": "gpt-4.1-mini",
          "ApiKey": "",
          "TimeoutSeconds": 40
        },
        {
          "Name": "Gemini",
          "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
          "Model": "gemini-2.5-flash",
          "ApiKey": "",
          "TimeoutSeconds": 40
        }
      ]
    }
  },
  "AiCache": {
    "Enabled": true,
    "TtlMinutes": 30
  },
  "AiQuota": {
    "DailyLimitPerPf": 20,
    "Enabled": true
  },
  "Worker": {
    "DailyOverloadAnalysis": {
      "Hour": 3
    }
  },
  "Services": {
    "Entrenamiento": {
      "BaseUrl": "http://localhost:8083"
    },
    "Estructura": {
      "BaseUrl": "http://localhost:8082"
    },
    "Seguimiento": {
      "BaseUrl": "http://localhost:8084"
    }
  },
  "AllowedHosts": "*"
}
