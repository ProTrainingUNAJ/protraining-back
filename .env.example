# Solo demostración: valores de desarrollo local, nunca usar en producción.
# Copialo a .env (que no se commitea): cp .env.example .env

# Usuario y contraseña de las 5 bases (cada servicio tiene su propia base)
POSTGRES_USER=protraining_app
POSTGRES_PASSWORD=demo_app_cambiar_05

# JWT compartido por los 5 servicios (la clave tiene que tener al menos 32 caracteres)
JWT_KEY=clave_local_de_desarrollo_cambiar_32+
JWT_ISSUER=protraining-identidad
JWT_AUDIENCE=protraining

# Development habilita Swagger en /swagger
ASPNETCORE_ENVIRONMENT=Development

# Modelo de Ollama para el perfil ia (opcional, por defecto llama3.2:1b)
OLLAMA_MODEL=llama3.2:1b

# API Key de Google Gemini para el respaldo del Asistente (opcional, de aistudio.google.com)
GEMINI_API_KEY=

# Segundos que espera el Asistente a cada IA antes de pasar al siguiente respaldo (opcional).
# Por defecto: Ollama 15 y Gemini 10. Si los subís, la suma tiene que quedar por debajo de los 100 s
# del gateway y de los 120 s del front ("Generar con IA"); por ejemplo, Ollama 60 y Gemini 30.
# OLLAMA_TIMEOUT_SECONDS=60
# GEMINI_TIMEOUT_SECONDS=30

# URL de Estructura para servicios que consultan al atleta logueado (Entrenamiento, Seguimiento)
Services__Estructura__BaseUrl=http://localhost:8082

# Credenciales VAPID para Web Push (generar con: npx web-push generate-vapid-keys)
VAPID_SUBJECT=mailto:soporte@protraining.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
