# Solo demostración: valores de desarrollo local, nunca usar en producción.
# Copialo a .env (que no se commitea): cp .env.example .env

# Usuario y contraseña de las 5 bases (cada servicio tiene su propia base)
POSTGRES_USER=protraining_app
POSTGRES_PASSWORD=demo_app_cambiar_05

# JWT compartido por los 5 servicios (la clave tiene que tener al menos 32 caracteres)
JWT_KEY=clave_local_de_desarrollo_cambiar_32+
JWT_ISSUER=protraining-identidad
JWT_AUDIENCE=protraining

# Development habilita Swagger en /swagger
ASPNETCORE_ENVIRONMENT=Development

# --- IA del Asistente: OpenAI → Gemini → reglas (README, "IA del Asistente") ---
# Las claves van SOLO en tu .env: se piden por privado y nunca se suben al repo, a Jira ni al grupo.
# Sin clave, ese proveedor se saltea; sin ninguna, los borradores salen de las reglas.

# 1º · OpenAI por el gateway de IA de la UNAJ (la clave la pasó el profesor)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://rs-ai-gateway-unaj.azure-api.net/unaj-llm/openai/deployments/gpt-4.1-mini/?api-version=2025-03-01-preview
OPENAI_MODEL=gpt-4.1-mini

# 2º · Gemini, si OpenAI falla (clave gratis en aistudio.google.com)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash

# Cadena de proveedores del agente: OpenAI -> Gemini -> reglas (los que no tienen clave se saltean).
# Tope de llamadas a herramientas del agente por pedido (KAN-600: 6). Protege el saldo de OpenAI.
# AI_AGENT_MAX_TOOL_CALLS=6

# Límite diario de pedidos a la IA por preparador físico (KAN-510). Subirlo el día de la demo si hace falta.
# AiQuota__DailyLimitPerPf=20

# Segundos máximos por proveedor. La suma (40 + 40 = 80 s) debe quedar por debajo de los 100 s
# del gateway y de los 120 s del front ("Generar con IA").
# OPENAI_TIMEOUT_SECONDS=40
# GEMINI_TIMEOUT_SECONDS=40

# --- Mails (confirmación del registro del PF, recuperar contraseña) ---
# En local se ven en Mailpit: http://localhost:8025. Para mandar mails reales, completá estas
# variables en tu .env; la contraseña de aplicación se pide por privado y nunca se sube.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_ENABLE_SSL=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=ProTraining

# WhatsApp del PF de la demo (opcional, para el seed: docker compose --profile seed run --rm seed)
# DEMO_PF_PHONE=+549...

# URL de Estructura para servicios que consultan al atleta logueado (Entrenamiento, Seguimiento)
Services__Estructura__BaseUrl=http://localhost:8082

# Credenciales VAPID para Web Push (generar con: npx web-push generate-vapid-keys)
VAPID_SUBJECT=mailto:soporte@protraining.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# URL Base del Frontend para enlaces en correos (confirmación, reseteo)
FRONTEND_BASE_URL=http://127.0.0.1:5173/

# Google Identity Services (Client ID OAuth 2.0 Web - no es secreto, debe coincidir con VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=644331202612-kj3vd8vl3jb7opcl9c7804m7g8e1m3rl.apps.googleusercontent.com
