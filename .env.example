# Solo demostración: valores de desarrollo local, nunca usar en producción.
POSTGRES_DB=protraining_demo
POSTGRES_USER=protraining_app
POSTGRES_PASSWORD=demo_app_cambiar_05

# API: conexión a la base
Database__Host=localhost
Database__Port=5432
Database__Name=protraining_demo
Database__User=protraining_app
Database__Password=demo_app_cambiar_05

# API: JWT (la clave tiene que tener al menos 32 caracteres)
Jwt__Key=clave_local_de_desarrollo_cambiar_32+
Jwt__Issuer=protraining-identidad
Jwt__Audience=protraining

# API: orígenes permitidos para CORS (uno por índice)
Cors__AllowedOrigins__0=http://localhost:5173
